# ─────────────────────────────────────────────────────────────────────────
# Resend — https://resend.com/api-keys
# Copy this file to .env.local and fill in real values.
# ─────────────────────────────────────────────────────────────────────────

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered.
# While using the onboarding@resend.dev sender below, this MUST be the email
# address that owns the Resend account — Resend will not deliver anywhere else.
CONTACT_TO_EMAIL=you@example.com

# Sender. Resend requires a VERIFIED DOMAIN for a custom From address.
CONTACT_FROM_EMAIL=Vision Infinite <onboarding@resend.dev>

# Once visioninfinite.com is verified in Resend, switch to:
# CONTACT_FROM_EMAIL=Vision Infinite <hello@visioninfinite.com>
